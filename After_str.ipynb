    "SELECT\n",
    "p.patient_id \"patient_id_patient\",\n",
    "str.id \"str_id\",\n",
    "str.patient_id \"patient_id_str\",\n",
    "str.model_condition_id \"model_condition_id_str\",\n",
    "str.*,\n",
    "sc.screen_id,\n",
    "sc.model_condition_id \"model_condition_id_screen\",\n",
    "sc.model_condition.model_id \"model_condition.model_id_screen\",\n",
    "seq.sequence_id,\n",
    "seq.screen_id \"screen_id_screen_sequence\",\n",
    "FROM str_profile str\n",
    "FULL OUTER JOIN patient p ON p.patient_id = str.patient_id\n",
    "FULL OUTER JOIN screen sc ON sc.\n",
    "FULL OUTER JOIN screen_sequence seq ON seq.\n",
    "\n",
    "LEFT JOIN model_condition mc ON str.model_condition_id=mc.model_condition_id\n",
