   "source": [
    "import pandas as pd\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dfbd5f03-3eba-4a47-a7db-3c2d090f09e9",
   "metadata": {},
   "source": [
    "#SQL query for pulling updated strs\n",
    "SELECT m.model_id,\n",
    "m.patient_id \"patient_id_model\",\n",
    "m.model_id \"model_model_id\",\n",
    "mc.model_condition_id \"mc_model_condition_id\",\n",
    "mc.model_id \"mc_model_id\",\n",
    "str.patient_id \"patient_id_str\",\n",
    "str.model_condition_id,\n",
    "str.*\n",
    "FROM str_profile str\n",
    "LEFT JOIN model_condition mc ON str.model_condition_id=mc.model_condition_id\n",
    "LEFT JOIN model m ON m.model_id=mc.model_id;"
   ]
  },
